# ---------------------------------------------------------------------------
# ربات تلگرام کپی محتوا  |  نمونه فایل تنظیمات
# این فایل را به نام .env کپی کنید و مقادیر را پر کنید.
# ---------------------------------------------------------------------------

# توکن ربات مدیریت (از @BotFather)
BOT_TOKEN=123456:AAaaBBbbCCccDDddEEeeFFffGGgg

# اطلاعات اپلیکیشن تلگرام (از https://my.telegram.org/apps)
# برای ورود کاربران با شماره تلفن (اکانت کاربری) لازم است
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# آیدی عددی مدیران ربات، جدا شده با کاما
ADMIN_IDS=123456789

# کلید رمزنگاری سشن کاربران (Fernet key)
# با دستور زیر بسازید:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# مسیر دیتابیس
DATABASE_URL=sqlite+aiosqlite:///data/telkap.db

# نام کاربری ربات (بدون @) - برای ساخت لینک‌ها
BOT_USERNAME=mycopybot

# آیدی پشتیبانی برای نمایش در ربات
SUPPORT_USERNAME=support

# کانال عضویت اجباری اولیه (اختیاری، بدون @). خالی = غیرفعال
# ⚠️ ربات باید در این کانال ادمین باشد تا بتواند عضویت را بررسی کند
# این فقط یک مقدار شروع است — پس از اجرای اول به جدول منتقل می‌شود و
# از آن پس هر تعداد کانال را از پنل ادمین → «📢 عضویت اجباری» اضافه کنید.
FORCE_JOIN_CHANNEL=

# --- پرداخت کارت‌به‌کارت ---
# اگر پر شود، کاربر پس از انتخاب پلن شماره کارت را می‌بیند و رسید را در
# ربات می‌فرستد؛ ادمین با یک دکمه تأیید می‌کند و اشتراک فعال می‌شود.
# اگر خالی بماند، کاربر به پشتیبانی ارجاع داده می‌شود.
CARD_NUMBER=
CARD_HOLDER=

# اختلاف ساعت محلی با UTC، برای زمان‌بندی کارها (ایران = 3.5)
TIMEZONE_OFFSET=3.5

# فاصله‌ی پشتیبان‌گیری خودکار دیتابیس بر حسب ساعت
BACKUP_HOURS=12

# چند روز گزارش فعالیت نگه داشته شود (0 = برای همیشه).
# با کاربران زیاد، این جدول سریع‌ترین بخش رشد دیتابیس است.
LOG_RETENTION_DAYS=14

# تعداد روز اشتراک رایگان هنگام ثبت‌نام (0 = بدون اشتراک رایگان)
TRIAL_DAYS=1

# محدودیت ارسال: حداکثر پیام در دقیقه به ازای هر مقصد
RATE_PER_MINUTE=20

# مسیر ذخیره موقت فایل‌ها
DOWNLOAD_DIR=data/downloads

# سطح لاگ
LOG_LEVEL=INFO

# --- پروکسی ---
# اگر شبکه‌ی شما به api.telegram.org دسترسی ندارد، پروکسی خود را اینجا بگذارید.
# هم ربات و هم اکانت کاربری از همین عبور می‌کنند.
# نمونه‌ها:
#   PROXY_URL=socks5://127.0.0.1:10808
#   PROXY_URL=http://127.0.0.1:10809
#   PROXY_URL=socks5://user:pass@1.2.3.4:1080
# خالی بگذارید اگر VPN شما حالت TUN/Global دارد.
PROXY_URL=

# ── اثر انگشت اکانت کاربری ───────────────────────────────────────────
# این مقادیر هم در «دستگاه‌های متصل» خود کاربر دیده می‌شوند و هم تلگرام
# آن‌ها را می‌بیند. پیش‌فرض‌ها شبیه یک کلاینت معمولی‌اند؛ نامی که خودش را
# «ربات» معرفی کند ریسک محدود شدن اکانت را بالا می‌برد.
DEVICE_MODEL=Desktop
SYSTEM_VERSION=Windows 10
APP_VERSION=4.16.8

# ── پشتیبان‌گیری بیرون از سرور ────────────────────────────────────────
# نسخه‌ی محلی به‌تنهایی محافظت واقعی نیست: اگر سرور از دست برود، پشتیبان
# هم با آن می‌رود. یک کانال خصوصی بسازید، ربات را در آن ادمین کنید تا هر
# نسخه فشرده و آنجا فرستاده شود.
#
# لازم نیست اینجا چیزی بگذارید: در ربات «⚙️ سیستم ← 🆔 گرفتن شناسه‌ی
# کانال» را بزنید، یک پیام از آن کانال فوروارد کنید و دکمه‌ی «همین را
# کانال پشتیبان کن» را بزنید — بدون ری‌استارت ذخیره می‌شود.
# این خط فقط پیش‌فرضِ اولیه است و تنظیمِ پنل بر آن اولویت دارد.
#   BACKUP_CHAT_ID=-1001234567890
BACKUP_CHAT_ID=

# ── پنل وب ───────────────────────────────────────────────────────────
# پنل مدیریت داخل همان پروسه‌ی ربات بالا می‌آید؛ چیزی جدا نصب نمی‌شود.
# پیش‌فرض خاموش است: تا اینجا true نشود هیچ پورتی باز نمی‌گردد.
WEB_ENABLED=false

# 127.0.0.1 یعنی فقط از خود سرور در دسترس است و باید یک وب‌سرور (nginx یا
# IIS) جلویش بگذارید که HTTPS را هم برساند. اگر می‌خواهید مستقیم از بیرون
# باز شود 0.0.0.0 بگذارید — ولی آن‌وقت بدون HTTPS کوکی ورود لخت روی شبکه
# می‌رود و هرکس وسط راه باشد می‌تواند واردِ پنل شود.
WEB_HOST=127.0.0.1
WEB_PORT=8080

# آدرسی که در مرورگر باز می‌شود. لینک ورود و نشانی بازگشت زرین‌پال هر دو
# از روی همین ساخته می‌شوند، پس اگر خالی بماند دکمه‌ی «🖥 پنل وب» نمی‌داند
# چه آدرسی به شما بدهد.
#
# ⚠️ حتماً با «/panel» تمام شود. یک زیردامنه سه چیز دارد — «/» صفحه‌ی
# فروش، «/panel» پنل، «/app» مینی‌اپ — و پنل زیر همان پیشوند نشسته.
# بدون آن، لینک ورود و بازگشت درگاه روی صفحه‌ی فروش می‌افتند. ربات موقع
# بالا آمدن این را می‌سنجد و اگر نخواند در لاگ هشدار می‌دهد.
#   WEB_BASE_URL=https://forwardbot.softmiliac.com/panel
WEB_BASE_URL=

# ── هوش مصنوعی ───────────────────────────────────────────────────────
# با هر سرویسی که رابط OpenAI را بفهمد کار می‌کند. پیش‌فرض AvalAI است که
# از ایران بدون فیلترشکن در دسترس است و با ریال هم شارژ می‌شود.
#   OpenAI مستقیم:   https://api.openai.com/v1
#   OpenRouter:      https://openrouter.ai/api/v1
#   Ollama محلی:     http://127.0.0.1:11434/v1
AI_BASE_URL=https://api.avalai.ir/v1

# ⚠️ کلید را فقط اینجا بگذارید. در چت، تیکت یا هیچ جای دیگری نفرستید.
# تا این خالی باشد، هیچ قابلیت هوش مصنوعی در ربات ظاهر نمی‌شود.
AI_API_KEY=

# چهار نقش جدا، چون هزینه‌شان ده‌ها برابر فرق می‌کند:
#   small  — دسته‌بندی و برچسب. ۹۰٪ فراخوانی‌ها. ارزان‌ترین مدل کافی است
#   main   — بازنویسی و ترجمه. کیفیت فارسی اینجا مهم است
#   vision — خواندن تصویر (تبلیغ داخل عکس، OCR)
#   embed  — بردار معنایی برای تشخیص تکراری و مسیریابی موضوعی
# ⚠️ این نام‌ها باید مو‌به‌مو با فهرست مدل‌های حساب شما بخوانند، وگرنه
# ۴۰۴ می‌گیرید. پس از پر کردن، در ربات «⚙️ سیستم ← 🤖 هوش مصنوعی» را
# بزنید تا هر چهار مدل واقعاً تست شوند.
AI_MODEL_SMALL=gpt-5-nano
AI_MODEL_MAIN=qwen3.5-flash
AI_MODEL_VISION=qwen3.5-flash
AI_MODEL_EMBED=text-embedding-3-small

# ── چرا این چهار مدل؟ ────────────────────────────────────────────────
# تحلیل کامل روی فهرست زنده‌ی API (۳۸۶ مدل): docs/AI-MODELS.md
#
# معیار اصلی «قیمت» نبود، «سقف نرخ» بود. چند مدل ده برابر ارزان‌ترند ولی
# در سطح ۱ فقط ۵ درخواست در دقیقه می‌دهند — برای رباتی که پست پردازش
# می‌کند بی‌فایده‌اند. مثلاً:
#
#   nvidia_nim.*                 0.007 ولی فقط ۵ درخواست/دقیقه   ✗
#   cohere.embed-multilingual-v3 0.100 و ۱۰ درخواست/دقیقه، زمینه ۵۱۲  ✗
#
#   gpt-5-nano             0.05/0.40   ۲۵۰ درخواست/دقیقه، JSON ساختارمند  ✓
#   qwen3.5-flash          0.10/0.40   ۱۹۰ درخواست/دقیقه، تصویر، چندزبانه ✓
#   text-embedding-3-small 0.02        ۳۰۰۰ درخواست/دقیقه، زمینه ۸۱۹۱     ✓
#
# اگر کیفیت فارسیِ بازنویسی راضی نکرد، AI_MODEL_MAIN را عوض کنید:
#   mistral-small-2503        0.10/0.30   ۱۵۰ درخواست/دقیقه
#   gemini-2.5-flash-lite     0.10/0.40   زمینه‌ی ۱ میلیون
#   qwen-mt-flash             0.16/0.49   مدل اختصاصی ترجمه
#
# ⚠️ فهرست تازه را هر وقت خواستید با ai-models.bat بگیرید.

# ── درگاه زرین‌پال ───────────────────────────────────────────────────
# کد پذیرنده (Merchant ID) از پنل زرین‌پال. خالی که باشد، درگاه در منوی
# پرداخت ظاهر نمی‌شود و فقط کارت‌به‌کارت و تتر می‌مانند.
#
# نشانی بازگشت از WEB_BASE_URL ساخته می‌شود — و چون WEB_BASE_URL خودش
# «/panel» دارد، می‌شود:
#     {WEB_BASE_URL}/pay/zarinpal
#     https://forwardbot.softmiliac.com/panel/pay/zarinpal
# همین را در پنل زرین‌پال ثبت کنید. پس پنل وب باید روی یک دامنه‌ی عمومی
# با HTTPS بالا باشد، وگرنه درگاه کار نمی‌کند.
#
# ⚠️ برخلاف کارت و تتر، این راه ادمین لازم ندارد: کاربر پرداخت می‌کند و
# اشتراکش همان لحظه فعال می‌شود.
ZARINPAL_MERCHANT=

# ── تأیید خودکار پرداخت تتر ──────────────────────────────────────────
# کلید TronGrid — رایگان از trongrid.io گرفته می‌شود.
#
# خالی هم کار می‌کند: بدون کلید، سقف درخواست سخت‌گیرانه‌تر است ولی
# برای چند پرداخت در روز کافی است. با کلید، سقف بالاتر می‌رود.
#
# چه می‌کند: وقتی کاربر هش تراکنش را می‌فرستد، ربات خودش بلاک‌چین را
# می‌خواند و اگر واریز به ولت شما رسیده و مبلغش کافی باشد، اشتراک را
# همان لحظه فعال می‌کند — بدون انتظار برای تأیید ادمین.
#
# پرداختی که تأیید نشود رد نمی‌شود؛ در صف ادمین می‌ماند.
TRON_API_KEY=
